      el('managerButton').addEventListener('click', openPinModal);
      el('closeCalculatorButton').addEventListener('click', closeCalculator);
      el('cancelPinButton').addEventListener('click', () => hideModal('pinModal'));
      el('verifyPinButton').addEventListener('click', verifyPin);
      el('pinInput').addEventListener('keydown', e => { if (e.key === 'Enter') verifyPin(); });
      el('closeMatrixButton').addEventListener('click', closeMatrix);
      el('downloadJsonButton').addEventListener('click', downloadJSON);
      el('excelInput').addEventListener('change', importExcelData);

      el('app-menus').addEventListener('click', e => {
        const card = e.target.closest('[data-menu]');
        if (card) openCalculator(card.dataset.menu);
      });

