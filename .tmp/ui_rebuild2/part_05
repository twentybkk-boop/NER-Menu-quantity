            const cat = String(row[0] || '').trim();
            if (cat && cat !== '-') lastCategory = cat;
            let menuName = String(row[1] || '').trim();
            if (menuName && menuName !== '-') lastOrigMenuName = menuName; else menuName = lastOrigMenuName;
            if (!menuName) continue;
            const recipe = {};
            for (let i = 2; i < headerRowOrig.length; i++) {
              const ingName = canonicalIngredientName(headerRowOrig[i]);
              if (!ingName || ingName === '-') continue;
              const val = row[i];
              if (val === undefined || val === '' || val === '-') continue;
              const num = parseFloat(val);
              if (!Number.isNaN(num) && num >= 0) recipe[ingName] = (recipe[ingName] || 0) + num;
            }
            if (Object.keys(recipe).length) {
              newOriginalMenu[menuName] = recipe;
              newMenuCategories[menuName] = lastCategory;
            }
          }

          const jsonRep = XLSX.utils.sheet_to_json(sheetRep, { header: 1, defval: '' });
          const repHeaderRowIdx = jsonRep.findIndex(row => row.some(cell => String(cell).trim() === 'หมูหมัก'));
          if (repHeaderRowIdx < 0) throw new Error('หา header ของ Replace Use ไม่พบ');
          const headerRowRep = jsonRep[repHeaderRowIdx];
          const repIngredientsList = [];
          for (let i = 2; i < headerRowRep.length; i++) {
            const h = canonicalIngredientName(headerRowRep[i]);
            if (h && h !== '-' && !repIngredientsList.includes(h)) repIngredientsList.push(h);
          }

          const newReplaceRules = [];
          let lastReplaceMenu = '';
          for (let r = repHeaderRowIdx + 1; r < jsonRep.length; r++) {
            const row = jsonRep[r];
            let menuName = String(row[0] || '').trim();
            if (menuName && menuName !== '-') lastReplaceMenu = menuName; else menuName = lastReplaceMenu;
            const excludeName = canonicalIngredientName(row[1]);
            if (!menuName || !excludeName) continue;
            const reps = {};
            for (let i = 2; i < headerRowRep.length; i++) {
              const ingName = canonicalIngredientName(headerRowRep[i]);
              if (!ingName || ingName === '-') continue;
              const val = row[i];
              if (val === undefined || val === '' || val === '-') continue;
              const num = parseFloat(val);
              if (!Number.isNaN(num)) reps[ingName] = (reps[ingName] || 0) + num;
            }
            if (Object.keys(reps).length) newReplaceRules.push({ menu: menuName, exclude: excludeName, replace: reps });
          }

          originalMenu = newOriginalMenu;
          menuCategories = newMenuCategories;
          replaceUseRules = newReplaceRules;
          allIngredientsList = repIngredientsList;
          initMenus();
          renderMatrixTable();
          alert('อัปโหลดและแปลงข้อมูลสำเร็จ!');
        } catch (err) {
          alert('Error: ' + err.message);
        } finally {
          event.target.value = '';
        }
      };
      reader.readAsArrayBuffer(file);
    }

    function downloadJSON() {
      if (!Object.keys(originalMenu).length) return alert('ยังไม่มีข้อมูลสูตรอาหาร กรุณาอัปโหลดไฟล์ Excel ก่อนครับ');
      const payload = { categories: menuCategories, baseMenu: originalMenu, replaceRules: replaceUseRules, ingredients: allIngredientsList };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'recipe_master.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    function editMatrixCell(rowIndex, ingredient, currentValue) {
      const row = replaceUseRules[rowIndex];
      if (!row) return;
      const newVal = prompt(`แก้ไขปริมาณแทนที่:\nเมนู: ${row.menu}\nหัก: ${row.exclude}\nแทนด้วย: ${ingredient}\n\nกรอกตัวเลขใหม่:`, currentValue);
      if (newVal !== null && !Number.isNaN(parseFloat(newVal))) {
        row.replace[ingredient] = parseFloat(newVal);
        renderMatrixTable();
      }
    }

    function renderMatrixTable() {
      if (!replaceUseRules.length) {
        el('tableContainer').innerHTML = '<div class="empty-state">ยังไม่มีข้อมูลสูตร กรุณาอัปโหลดไฟล์ Excel ด้านบน</div>';
        return;
      }
      const headers = allIngredientsList.map(h => `<th>${escapeHtml(h)}</th>`).join('');
      const rows = replaceUseRules.map((row, rIdx) => {
        const cells = allIngredientsList.map(ing => {
          const raw = row.replace[ing];
          let display = '-';
          if (raw !== undefined && raw !== null && raw !== '') {
            const num = parseFloat(raw);
            if (!Number.isNaN(num)) {
              const rounded = applySmartRounding(ing, num);
              display = (rounded > 0 || getUnit(ing) !== 'กรัม') ? rounded : '-';
            }
          }
          const editable = raw !== undefined && raw !== null && raw !== '' && !Number.isNaN(parseFloat(raw));
          return `<td class="${editable ? 'matrix-cell-edit' : ''}" data-row="${rIdx}" data-ing="${escapeHtml(ing)}" data-raw="${editable ? raw : 0}">${display}</td>`;
        }).join('');
        return `<tr><td class="sticky-1"><strong>${escapeHtml(row.menu)}</strong></td><td class="sticky-2" style="color:#b84a55;font-weight:800">❌ ${escapeHtml(row.exclude)}</td>${cells}</tr>`;
      }).join('');
      el('tableContainer').innerHTML = `<table class="matrix-table"><thead><tr><th class="sticky-1">ชื่อเมนู</th><th class="sticky-2">ไม่เอา...</th>${headers}</tr></thead><tbody>${rows}</tbody></table>`;
    }

