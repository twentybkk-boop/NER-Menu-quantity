    function openPinModal() {
      el('pinInput').value = '';
      showModal('pinModal');
      setTimeout(() => el('pinInput').focus(), 80);
    }
    async function verifyPin() {
      const bytes = new TextEncoder().encode(el('pinInput').value);
      const digest = await crypto.subtle.digest('SHA-256', bytes);
      const hash = Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2, '0')).join('');
      if (hash === '22dbfd569af550fb73ceb471588d0f7a30c8a13ca97701c1bc326ae324e49f73') {
        hideModal('pinModal');
        openMatrix();
      } else {
        alert('รหัสผ่านไม่ถูกต้อง');
      }
    }
    function openMatrix() { renderMatrixTable(); showModal('matrixModal'); }
    function closeMatrix() { hideModal('matrixModal'); }

