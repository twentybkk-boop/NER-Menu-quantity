    #tableContainer { flex: 1; overflow: auto; padding: 12px; background: #fbf5ed; }
    .matrix-table { border-collapse: collapse; width: 100%; min-width: 980px; white-space: nowrap; background: #fffdf9; font-size: 11px; }
    .matrix-table th, .matrix-table td { padding: 10px; border-bottom: 1px solid #eee2d8; text-align: center; }
    .matrix-table th { position: sticky; top: 0; z-index: 6; background: #f4e7dc; color: #4a382e; font-size: 10px; }
    .matrix-table .sticky-1 { position: sticky; left: 0; z-index: 5; min-width: 145px; text-align: left; background: #fffdf9; }
    .matrix-table .sticky-2 { position: sticky; left: 145px; z-index: 5; min-width: 150px; text-align: left; background: #fffdf9; }
    .matrix-table th.sticky-1, .matrix-table th.sticky-2 { z-index: 8; background: #efe0d4; }
    .matrix-cell-edit { background: #fff8f1; color: #6d4937; font-weight: 800; cursor: pointer; }
    .matrix-cell-edit:hover { background: #f2e0d0; }

    @media (max-width: 960px) {
      .menu-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .decor-a { left: -112px; }
      .decor-b { left: -112px; }
      .decor-c { right: -112px; }
    }

    @media (max-width: 767px) {
      #app-shell { width: min(100% - 24px, 680px); padding-top: max(18px, env(safe-area-inset-top)); }
      .hero { padding: 20px; border-radius: 25px; }
      .hero-row { flex-direction: column; align-items: stretch; }
      .brand-title { font-size: 25px; }
      .brand-subtitle { font-size: 13px; }
      .manager-btn { width: 100%; }
      #app-menus { margin-top: 28px; }
      .category-title { margin-left: -2px; margin-right: -2px; font-size: 20px; padding: 12px 14px; }
      .menu-grid { grid-template-columns: 1fr; gap: 14px; }
      .menu-card { min-height: 116px; padding: 18px; }

      /* On phones the art peeks out rather than sitting beneath controls. */
      .decor-a { width: 135px; height: 182px; left: -105px; top: 270px; opacity: .66; background-size: 520px auto; }
      .decor-b { width: 132px; height: 178px; left: -103px; top: 1130px; opacity: .50; background-size: 520px auto; }
      .decor-c { width: 132px; height: 205px; right: -103px; top: 790px; opacity: .53; background-size: 520px auto; }

      .modal { padding: 7px; align-items: flex-start; padding-top: max(7px, env(safe-area-inset-top)); }
      .modal-card { max-height: calc(100dvh - 14px - env(safe-area-inset-top)); border-radius: 24px; }
      .modal-header { padding: 16px; }
      .modal-title { font-size: 22px; }
      .calculator-body { display: flex; flex-direction: column; overflow-y: auto; }
      .calc-panel { overflow: visible; padding: 16px; }
      #leftPanel { border-right: 0; border-bottom: 1px solid #eddfd3; }
      #rightPanel { flex: 0 0 auto; }
      #netResultList { grid-template-columns: 1fr; }
      .replacement-wrap { margin-left: 7px; }
      .replacement-menu { max-height: 235px; }

      .matrix-card { width: 100%; height: calc(100dvh - 14px); max-height: calc(100dvh - 14px); }
      .matrix-header { align-items: flex-start; flex-direction: column; }
      .matrix-actions { width: 100%; }
    }
