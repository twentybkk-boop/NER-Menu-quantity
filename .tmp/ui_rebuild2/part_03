        <button id="verifyPinButton" class="btn-primary" type="button">ยืนยัน</button>
      </div>
    </div>
  </div>

  <script>
    const unitMap = {
      "กุ้ง": "ตัว", "ไข่ไก่": "ฟอง", "ไข่ไก่สด": "ฟอง", "มาม่า": "ก้อน",
      "หมี่หยก": "ก้อน", "หมี่หยก(สด)": "ก้อน", "เส้นอุด้ง": "g", "เต้าหู้ปลา": "ชิ้น",
      "เต้าหู้ไข่": "หลอด", "เต้าหู้ชีส": "ชิ้น", "ฟองเต้าหู้แท่ง": "แท่ง",
      "ฟองเต้าหู้ทอด": "ม้วน", "ซาโมซ่ากล้วย": "ชิ้น", "สละลอยแก้ว": "ถ้วย",
      "ลูกตาลลอยแก้ว": "ถ้วย", "โมจิไอศครีม": "ลูก", "ปลาหมึก": "กรัม"
    };

    const ingredientNameAliases = {
      "ปลากหมึก": "ปลาหมึก",
      "เนื้อเสื้อร้องให้สไลซ์": "เนื้อเสือร้องไห้สไลซ์"
    };

    const GITHUB_JSON_URL = "https://raw.githubusercontent.com/twentybkk-boop/NER-Menu-quantity/main/recipe_master.json";

    let menuCategories = {};
    let originalMenu = {};
    let replaceUseRules = [];
    let allIngredientsList = [];
    let currentActiveMenu = null;
    let excludedItemsMap = {};
    let openReplacementPicker = null;

    const veggieGroups = [
      "กะหล่ำปลี", "ผักบุ้ง", "ผักชีฝรั่ง", "โหระพา", "ใบชะพลู", "วุ้นเส้น",
      "ไข่ไก่", "ไข่ไก่สด", "เต้าหู้ปลา", "เต้าหู้ไข่", "เต้าหู้ชีส", "ฟองเต้าหู้แท่ง", "ฟองเต้าหู้ทอด"
    ];

    const el = (id) => document.getElementById(id);
    const getUnit = (item) => unitMap[String(item).trim()] || "กรัม";
    const canonicalIngredientName = (item) => {
      const clean = String(item || "").trim();
      return ingredientNameAliases[clean] || clean;
    };
    const escapeHtml = (value) => String(value)
      .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#039;');

    function showModal(id) {
      el(id).classList.remove('is-hidden');
      document.body.style.overflow = 'hidden';
    }
    function hideModal(id) {
      el(id).classList.add('is-hidden');
      if (el('calculatorModal').classList.contains('is-hidden') && el('matrixModal').classList.contains('is-hidden') && el('pinModal').classList.contains('is-hidden')) {
        document.body.style.overflow = '';
      }
    }

    function applySmartRounding(itemName, rawValue) {
      if (rawValue === undefined || rawValue === null || rawValue === '') return 0;
      const num = Number(rawValue);
      return Number.isNaN(num) ? 0 : Math.round(num);
    }

    function calculateNetRecipe(menuName) {
      const baseRecipe = originalMenu[menuName];
      if (!baseRecipe) return [];
      const netRecipeMap = { ...baseRecipe };
      const modifiedFlags = {};

      Object.keys(excludedItemsMap).forEach(ex => delete netRecipeMap[ex]);

      Object.entries(excludedItemsMap).forEach(([ex, rep]) => {
        if (!rep) return;
        const rule = replaceUseRules.find(r => String(r.menu).trim() === String(menuName).trim() && String(r.exclude).trim() === String(ex).trim());
        if (rule?.replace?.[rep] !== undefined) {
          const addAmt = Number(rule.replace[rep]) || 0;
          netRecipeMap[rep] = (Number(netRecipeMap[rep]) || 0) + addAmt;
          modifiedFlags[rep] = true;
        }
      });

      return Object.entries(netRecipeMap).flatMap(([item, rawTotal]) => {
        const unit = getUnit(item);
        const qty = applySmartRounding(item, rawTotal);
        if (qty <= 0 && unit === 'กรัม') return [];
        return [{ name: item, qty, unit, isModified: modifiedFlags[item] === true }];
      });
    }

    function getSortedReplacementOptions(menuName, excludedItem) {
      const menuBaseIngredients = Object.keys(originalMenu[menuName] || {});
      const rule = replaceUseRules.find(r => String(r.menu).trim() === String(menuName).trim() && String(r.exclude).trim() === String(excludedItem).trim());
      const options = [];

      if (rule?.replace) {
        Object.entries(rule.replace).forEach(([repItem, repQty]) => {
          if (repItem === excludedItem) return;
          const qty = Number(repQty);
          if (menuBaseIngredients.includes(repItem) && excludedItemsMap[repItem] === undefined && repQty !== undefined && !Number.isNaN(qty)) {
            options.push({ name: repItem, qty, selectable: qty > 0 });
          }
        });
      }

      if (veggieGroups.includes(excludedItem)) {
        options.sort((a, b) => Number(veggieGroups.includes(b.name)) - Number(veggieGroups.includes(a.name)));
      }
      return options;
    }

    function getSortedValidReplacements(menuName, excludedItem) {
      return getSortedReplacementOptions(menuName, excludedItem).filter(x => x.selectable).map(x => x.name);
    }

    function checkAndFixFallbacks() {
      Object.keys(excludedItemsMap).forEach(ex => {
        const currentRep = excludedItemsMap[ex];
        const valid = getSortedValidReplacements(currentActiveMenu, ex);
        if (excludedItemsMap[currentRep] !== undefined || !valid.includes(currentRep)) excludedItemsMap[ex] = valid[0] || '';
      });
    }

    async function loadData() {
      try {
        const res = await fetch(`${GITHUB_JSON_URL}?t=${Date.now()}`, { cache: 'no-store' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        if (!data.baseMenu || !data.replaceRules) throw new Error('Invalid recipe_master.json');
        originalMenu = data.baseMenu;
        menuCategories = data.categories || {};
        replaceUseRules = data.replaceRules;
        allIngredientsList = data.ingredients || [];
        initMenus();
        renderMatrixTable();
      } catch (err) {
        console.error(err);
        el('app-menus').innerHTML = '<div class="empty-state">❌ ไม่พบไฟล์ข้อมูลกลาง (recipe_master.json)<br><small>กรุณาเข้าหลังบ้านเพื่ออัปโหลด Excel ใหม่</small></div>';
      }
    }

    function initMenus() {
      const grouped = {};
      Object.keys(originalMenu).forEach(menu => {
        const cat = menuCategories[menu] || 'อื่นๆ';
        (grouped[cat] ||= []).push(menu);
      });

      el('app-menus').innerHTML = Object.entries(grouped).map(([cat, menus]) => `
        <section class="category-block">
