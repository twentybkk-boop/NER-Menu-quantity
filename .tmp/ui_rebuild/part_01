      box-shadow: 0 4px 12px rgba(82,59,43,.035);
    }
    .net-card.modified { background: var(--green-soft); border: 2px solid #a9b99a; }
    .net-name { min-width: 0; font-size: 12px; line-height: 1.3; font-weight: 800; color: #4b3a31; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .net-amount { display: flex; align-items: baseline; gap: 4px; flex: 0 0 auto; }
    .net-qty { font-size: 22px; line-height: 1; font-weight: 800; color: #2d2926; }
    .net-unit { font-size: 10px; font-weight: 800; color: #8d7f74; }
    .modified .net-name, .modified .net-qty { color: #526743; }

    /* PIN */
    .pin-card { width: min(390px, 100%); padding: 28px; text-align: center; }
    .pin-title { margin: 0 0 16px; color: var(--brown-dark); font-size: 21px; font-weight: 800; }
    .pin-input {
