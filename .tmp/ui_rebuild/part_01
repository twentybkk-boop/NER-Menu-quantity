
      display: flex;
      flex-direction: column;
      background: var(--paper-solid);
      border: 1px solid #e9d8ca;
      border-radius: 28px;
      box-shadow: var(--shadow-strong);
    }
    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 22px;
      border-bottom: 1px solid #eadccf;
      background: linear-gradient(180deg, #fffaf4, #fbf2e8);
    }
    .modal-title { margin: 0; font-size: 24px; line-height: 1.25; font-weight: 800; color: var(--brown-dark); }
    .modal-subtitle { margin: 5px 0 0; color: #887b72; font-size: 13px; line-height: 1.5; }
    .close-btn {
      width: 46px; height: 46px; flex: 0 0 46px;
      border: 1px solid #dfd0c3; border-radius: 50%;
      background: #fff; color: #64574f; font-size: 22px; cursor: pointer;
      box-shadow: 0 4px 12px rgba(80,56,42,.06);
    }

    .calculator-body { min-height: 0; display: grid; grid-template-columns: 45% 55%; }
    .calc-panel { overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 22px; min-height: 0; }
    #leftPanel { background: #fffdf9; border-right: 1px solid #eddfd3; }
    #rightPanel { background: #fbf5ed; }
    .panel-title {
      display: flex; align-items: center; gap: 9px; margin: 0 0 16px;
      font-size: 14px; font-weight: 800; line-height: 1.45;
    }
    .panel-title.reject { color: var(--rose); }
    .panel-title.result { color: var(--green); }
    .dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
    .reject .dot { background: var(--rose); }
    .result .dot { background: var(--green); }

    .exclude-item { margin-bottom: 11px; }
    .exclude-btn {
      width: 100%; min-height: 52px; padding: 12px 15px;
      border: 1.5px solid #e4d8cd; border-radius: 16px;
      background: #fff; color: #394150; font-weight: 800; font-size: 14px;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      text-align: left; cursor: pointer;
    }
    .exclude-btn.is-excluded { border-color: #df6873; color: #b83d49; background: var(--rose-soft); }
    .exclude-status { flex: 0 0 auto; font-size: 12px; font-weight: 800; }

    .replacement-wrap { margin: 8px 2px 4px 14px; padding-left: 10px; border-left: 3px solid #d9c2ae; }
    .replacement-trigger {
      width: 100%; min-height: 50px; border: 1.5px solid #ddcbbb; border-radius: 14px;
      background: #fffaf4; color: var(--brown-dark); padding: 10px 12px;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      text-align: left; font-size: 14px; font-weight: 800; cursor: pointer;
    }
    .replacement-trigger small { display: block; margin-top: 2px; font-size: 11px; font-weight: 600; color: #9b8878; }
    .chevron { font-size: 19px; color: #99735a; transition: transform .14s ease; }
    .replacement-trigger.is-open .chevron { transform: rotate(180deg); }
    .replacement-menu {
      margin-top: 7px; max-height: 285px; overflow-y: auto; -webkit-overflow-scrolling: touch;
      border: 1px solid #e2d2c4; border-radius: 15px; background: #fff;
      box-shadow: 0 12px 26px rgba(73,49,38,.12);
    }
    .replacement-option {
      width: 100%; min-height: 49px; padding: 11px 13px;
      border: 0; border-bottom: 1px solid #f0e5dc;
      background: #fff; color: #38404d; font-size: 14px; font-weight: 700;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      text-align: left;
    }
    .replacement-option:last-child { border-bottom: 0; }
    .replacement-option.selectable { cursor: pointer; }
    .replacement-option.selectable:active { background: #f8efe7; }
    .replacement-option.selected { background: #f2ede7; color: var(--brown-dark); }
    .replacement-option.disabled { color: #aaa19a; background: #fbf8f5; cursor: not-allowed; }
    .option-note {
      flex: 0 0 auto; padding: 4px 8px; border-radius: 999px;
      background: #f4e6e7; color: #98666b; font-size: 10px; font-weight: 800;
    }
    .selected-mark { color: var(--green); font-size: 11px; font-weight: 800; }
    .picker-empty { padding: 14px; color: #968a80; font-size: 12px; font-weight: 700; }

    #netResultList { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .net-card {
      min-height: 60px; padding: 13px;
      border: 1px solid #e6d9ce; border-radius: 15px; background: #fff;
